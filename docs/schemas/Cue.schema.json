          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Data",
      "type": "object"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "lang": {
      "default": "en",
      "title": "Lang",
      "type": "string"
    },
    "match_id": {
      "title": "Match Id",
      "type": "string"
