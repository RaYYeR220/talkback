          "type": "array"
        },
        "span": {
          "title": "Span",
          "type": "string"
        },
        "strength": {
          "default": 0,
          "maximum": 3,
          "minimum": 0,
          "title": "Strength",
          "type": "integer"
        },
        "subject": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
